# Auto detect text files and perform LF normalization
* text=auto

# Explicitly ensure Linux scripts and config files use LF line endings
*.sh text eol=lf
kalitorify.sh text eol=lf
Makefile text eol=lf
CHANGELOG text eol=lf
LICENSE text eol=lf
*.md text eol=lf
data/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
